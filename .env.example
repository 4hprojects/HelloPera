# HelloPera — environment template
# Copy to .env.local and fill in. Never commit real values.

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# API URL. Dashboard > Project Settings > API > Project URL.
#
# NOTE: this is NOT the database host. The value you want has no "db." prefix:
#   correct    https://<ref>.supabase.co
#   wrong      https://db.<ref>.supabase.co     <- Postgres host, IPv6-only,
#                                                  does not serve the API
NEXT_PUBLIC_SUPABASE_URL=

# Anon/publishable key. Safe to expose to the browser.
# Sanity check: decode the JWT and confirm the "role" claim is "anon".
# If it says "service_role", stop — that key must never be NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never prefix with NEXT_PUBLIC_.
#
# Required from Phase 01. User-owned tables grant the browser SELECT only, so
# every mutation runs through a server action holding this key, with ownership
# checked in code first.
#
# Dashboard > Project Settings > API Keys > Secret keys. Starts "sb_secret_".
# NOT the publishable key, and there is no "sb_service_role_" prefix.
# The legacy service_role JWT also works, under either variable name.
#
# Verify with: npm run check:key
SUPABASE_SECRET_KEY=

# ---------------------------------------------------------------------------
# Database (migrations and tooling only — the app uses supabase-js)
# ---------------------------------------------------------------------------
# Used by `npm run db:migrate`. Not used by the app itself.
#
# Dashboard > Settings > Database > Connection string > URI.
# Use the POOLER host (aws-N-<region>.pooler.supabase.com) — the direct
# db.<ref>.supabase.co host is IPv6-only and will not connect from most
# networks. The migration runner refuses it with a message saying so.
DATABASE_URL=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=HelloPera
NEXT_PUBLIC_APP_URL=http://localhost:3000
