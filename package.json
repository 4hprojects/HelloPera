{
  "name": "hello-pera",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev -p 3030",
    "build": "next build",
    "start": "next start -p 3030",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "check:node": "node scripts/check-node.mjs",
    "preflight": "npm run check:node && npm run check:key && npm run typecheck && npm run lint && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/build-icons.mjs",
    "test": "vitest run --exclude \"**/*.integration.test.ts\"",
    "test:watch": "vitest",
    "db:migrate": "node scripts/db.mjs migrate",
    "db:bundle": "node scripts/build-migrations.mjs",
    "db:status": "node scripts/db.mjs status",
    "db:verify": "node scripts/db.mjs verify",
    "check:key": "node scripts/check-key.mjs",
    "ops:check": "node scripts/check-operations.mjs",
    "test:integration": "node scripts/run-staging-tests.mjs integration",
    "test:db": "node scripts/test-database.mjs",
    "test:e2e": "playwright test public.spec.ts",
    "test:e2e:staging": "node scripts/run-staging-tests.mjs browser",
    "verify:restore": "node scripts/verify-restore.mjs",
    "test:performance:medium": "HELLOPERA_PERF_PROFILE=medium node scripts/run-staging-tests.mjs browser",
    "test:performance:large": "HELLOPERA_PERF_PROFILE=large node scripts/run-staging-tests.mjs browser"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.125.0",
    "@supabase/server": "^1.4.1",
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "16.3.5",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "server-only": "^0.0.1",
    "sharp": "^0.35.4",
    "web-push": "^3.6.7",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
